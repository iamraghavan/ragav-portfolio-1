# Your final Vercel or custom-domain origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Server-only email configuration. Use a sender on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=raghavanofficials@gmail.com

# Spotify: server-only. A temporary access token works for a manual sync.
SPOTIFY_ACCESS_TOKEN=
# Set all three below for automatic refresh of your personal top tracks.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
